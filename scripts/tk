#!/usr/bin/env python3
"""tk: forge-agnostic ticket CLI and hook engine (stdlib only).

Backends are detected from the git remote: forgejo (issues + status:* labels),
github (private Projects v2 DRAFT items through a dedicated GitHub App: no
issue, no notification, no gh CLI, no personal token), local (JSON under the
git common dir). State never enters the working tree.
Hook modes (tk hook <pretool|prompt|stop|session>) are fail-open on internal
errors and never loop: a Stop block is capped, the remainder becomes a debt
re-injected at the next prompt.
"""
import base64
import calendar
import contextlib
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

try:
    import fcntl
except ImportError:  # pragma: no cover - non-POSIX platforms
    fcntl = None

COLS = ("todo", "in-progress", "review", "done")
STOP_CAP = 2
HOME = os.path.expanduser("~")


class BackendError(Exception):
    """A backend cannot be used; the message is meant for the owner."""


def cfg_path():
    return os.environ.get("TK_CONFIG") or os.path.join(HOME, ".claude", "tk", "config.json")


def load_cfg():
    try:
        with open(cfg_path(), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def run(cmd, cwd=None, stdin=None):
    p = subprocess.run(cmd, cwd=cwd, input=stdin, capture_output=True, text=True, check=False)
    return p.returncode, p.stdout.strip(), p.stderr.strip()


def git(args, cwd=None):
    code, out, _ = run(["git", *args], cwd=cwd)
    return out if code == 0 else ""


def die(msg, code=1):
    sys.stderr.write("tk: " + msg + "\n")
    sys.exit(code)


def atomic_write_json(path, obj):
    """Write a whole file atomically: unique temp in the same dir, then rename."""
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d or ".", prefix="." + os.path.basename(path) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=1)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


@contextlib.contextmanager
def file_lock(path):
    """Exclusive advisory lock; a no-op where fcntl is absent."""
    if fcntl is None:  # pragma: no cover - non-POSIX platforms
        yield
        return
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(path, "a+", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def parse_remote(url):
    """(host, owner, repo, prefix) from an ssh/https/scp-like remote, or None."""
    m = (re.match(r"^[a-z+]+://(?:[^@/]+@)?([^/:]+)(?::\d+)?/(.+?)(?:\.git)?/?$", url)
         or re.match(r"^(?:[^@/]+@)?([^/:]+):(.+?)(?:\.git)?/?$", url))
    if not m:
        return None
    parts = m.group(2).split("/")
    if len(parts) < 2:
        return None
    return resolve_ssh_alias(m.group(1)), parts[-2], parts[-1], "/".join(parts[:-2])


def resolve_ssh_alias(host):
    """Real hostname behind an ~/.ssh/config alias (`Host x` / `HostName y`); host itself if none."""
    try:
        out = subprocess.run(["ssh", "-G", host], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return host
    for line in out.splitlines():
        if line.startswith("hostname "):
            return line.split(None, 1)[1].strip() or host
    return host


class Ctx:
    """Repository context: where the repo is, who owns it, which backend."""

    def __init__(self, cwd):
        self.cfg = load_cfg()
        self.top = git(["rev-parse", "--show-toplevel"], cwd)
        common = git(["rev-parse", "--git-common-dir"], cwd)
        self.common = os.path.abspath(os.path.join(cwd, common)) if common else ""
        self.sdir = os.path.join(self.common, "tk") if self.common else ""
        self.remote = parse_remote(git(["remote", "get-url", "origin"], cwd) or "") if self.top else None
        host = self.remote[0] if self.remote else ""
        self.host = host
        self.owner = self.remote[1] if self.remote else ""
        self.repo = self.remote[2] if self.remote else os.path.basename(self.top or "")
        hostcfg = (self.cfg.get("hosts") or {}).get(host, {})
        default = "github" if host == "github.com" else "forgejo"
        if hostcfg:
            self.kind = hostcfg.get("kind") or default
        elif host == "github.com":
            self.kind = "github"
        else:
            self.kind = "local"
        self.hostcfg = hostcfg

    @property
    def in_repo(self):
        return bool(self.top)

    @property
    def enabled(self):
        if not self.in_repo:
            return False
        if git(["config", "--get", "tk.enabled"], self.top) == "true":
            return True
        if os.path.exists(os.path.join(self.top, ".claude", "tk.enabled")):
            return True
        owners = {o.lower() for o in self.cfg.get("owners", [])}
        if self.remote:
            return self.owner.lower() in owners
        return bool(self.cfg.get("local_repos", False))

    @property
    def deferred(self):
        """The repo ships its own ticket gate: repo policy wins over the global one."""
        return os.path.exists(os.path.join(self.top, ".claude", "hooks", "guard-edit-ticket.py"))

    def state(self):
        try:
            with open(os.path.join(self.sdir, "state.json"), encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return {}

    def save(self, st):
        atomic_write_json(os.path.join(self.sdir, "state.json"), st)

    def token(self):
        env = self.hostcfg.get("token_env")
        if env and os.environ.get(env):
            return os.environ[env]
        key = self.hostcfg.get("token_dotenv")
        if key and self.top:
            try:
                with open(os.path.join(self.top, ".env"), encoding="utf-8") as fh:
                    for line in fh:
                        m = re.match(r"\s*" + re.escape(key) + r"\s*=\s*[\"']?([^\"'\s]+)", line)
                        if m:
                            return m.group(1)
            except OSError:
                pass
        return ""


# ---------------------------------------------------------------- backends

class Local:
    name = "local"

    def __init__(self, ctx):
        self.ctx = ctx
        self.path = os.path.join(ctx.sdir, "tickets.json")
        self.lock = os.path.join(ctx.sdir, "lock")

    def _load(self):
        try:
            with open(self.path, encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return {"next": 1, "items": {}}

    def _save(self, d):
        atomic_write_json(self.path, d)

    def ensure(self):
        return "local store " + self.path

    def new(self, title, body):
        with file_lock(self.lock):
            d = self._load()
            tid = "L%d" % d["next"]
            d["next"] += 1
            d["items"][tid] = {"title": title, "body": body, "status": "todo", "notes": []}
            self._save(d)
        return tid

    def get(self, tid):
        it = self._load()["items"].get(tid)
        if it is None:
            die("unknown ticket " + tid)
        return {"id": tid, "title": it["title"], "status": it["status"], "notes": len(it["notes"])}

    def set_status(self, tid, status):
        with file_lock(self.lock):
            d = self._load()
            d["items"][tid]["status"] = status
            self._save(d)

    def note(self, tid, text):
        with file_lock(self.lock):
            d = self._load()
            d["items"][tid]["notes"].append(text)
            self._save(d)

    def list(self, show_done=False):
        return [{"id": k, "title": v["title"], "status": v["status"], "notes": len(v["notes"])}
                for k, v in self._load()["items"].items()
                if show_done or v["status"] != "done"]


class Forgejo:
    name = "forgejo"

    def __init__(self, ctx):
        self.ctx = ctx
        api = ctx.hostcfg.get("api")
        if not api:
            raise BackendError("no api configured for host " + ctx.host + " in " + cfg_path())
        self.api = api.rstrip("/")
        self.tok = ctx.token()
        if not self.tok:
            raise BackendError("no token for host " + ctx.host + " (hosts." + ctx.host + ".token_env / token_dotenv)")
        self.base = "/repos/%s/%s" % (ctx.owner, ctx.repo)

    def call(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.api + path, data=data, method=method, headers={
            "Authorization": "token " + self.tok, "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            raise BackendError("forgejo %s %s -> HTTP %d" % (method, path, e.code))
        except (urllib.error.URLError, OSError) as e:
            raise BackendError("forgejo unreachable: %s" % e)
        return json.loads(raw) if raw else None

    def ensure(self):
        have = {l["name"] for l in self.call("GET", self.base + "/labels?limit=100") or []}
        made = []
        for c in COLS:
            if "status:" + c not in have:
                self.call("POST", self.base + "/labels", {"name": "status:" + c, "color": "#0e8a16"})
                made.append(c)
        return "status labels ok" + (" (created: %s)" % ",".join(made) if made else "")

    def _view(self, issue):
        st = next((l["name"][7:] for l in issue.get("labels") or [] if l["name"].startswith("status:")), "todo")
        if issue.get("state") == "closed":
            st = "done"
        return {"id": str(issue["number"]), "title": issue["title"], "status": st,
                "notes": int(issue.get("comments") or 0)}

    def new(self, title, body):
        i = self.call("POST", self.base + "/issues", {"title": title, "body": body, "labels": ["status:todo"]})
        return str(i["number"])

    def get(self, tid):
        return self._view(self.call("GET", "%s/issues/%s" % (self.base, tid)))

    def set_status(self, tid, status):
        i = self.call("GET", "%s/issues/%s" % (self.base, tid))
        keep = [l["name"] for l in i.get("labels") or [] if not l["name"].startswith("status:")]
        self.call("PUT", "%s/issues/%s/labels" % (self.base, tid), {"labels": keep + ["status:" + status]})
        want = "closed" if status == "done" else "open"
        if i.get("state") != want:
            self.call("PATCH", "%s/issues/%s" % (self.base, tid), {"state": want})

    def note(self, tid, text):
        self.call("POST", "%s/issues/%s/comments" % (self.base, tid), {"body": text})

    def list(self, show_done=False):
        state = "all" if show_done else "open"
        return [self._view(i) for i in self.call(
            "GET", self.base + "/issues?state=%s&type=issues&limit=50" % state) or []]


def b64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


class GitHub:
    """Private Projects v2 DRAFT items through a dedicated GitHub App.

    Auth is a JWT RS256 signed by the openssl binary, exchanged for an
    installation token cached under <git-common-dir>/tk. Never creates an
    issue, never comments, never invokes gh, never uses a personal token.
    """

    name = "github"
    PROJECT = "%s tasks"
    RETRY_SECONDS = 300
    TOKEN_MARGIN = 300

    def __init__(self, ctx):
        self.ctx = ctx
        hc = ctx.hostcfg
        if not hc:
            raise BackendError("github backend needs hosts[%r] in %s" % (ctx.host, cfg_path()))
        self.app_id = str(hc.get("app_id") or "")
        self.installation = ""
        self.key_path = hc.get("private_key_path") or ""
        missing = [k for k, v in (("app_id", self.app_id), ("private_key_path", self.key_path)) if not v]
        if missing:
            raise BackendError("github backend config in %s lacks: %s" % (cfg_path(), ", ".join(missing)))
        if not os.path.isfile(self.key_path):
            raise BackendError("github app private key not found: " + self.key_path)
        self.api = (os.environ.get("TK_GH_API") or hc.get("api") or "https://api.github.com").rstrip("/")
        self.pid = ctx.state().get("gh_project")

    # -- auth ---------------------------------------------------------
    def _jwt(self):
        now = int(time.time())
        head = {"alg": "RS256", "typ": "JWT"}
        body = {"iat": now - 60, "exp": now + 540, "iss": self.app_id}
        raw = (b64url(json.dumps(head, separators=(",", ":")).encode()) + "."
               + b64url(json.dumps(body, separators=(",", ":")).encode()))
        try:
            p = subprocess.run(["openssl", "dgst", "-sha256", "-sign", self.key_path],
                               input=raw.encode(), capture_output=True, check=False)
        except OSError as e:
            raise BackendError("openssl is required to sign the GitHub App JWT: %s" % e)
        if p.returncode != 0:
            raise BackendError("github app key signing failed: " + p.stderr.decode(errors="replace")[:300])
        return raw + "." + b64url(p.stdout)

    def _installation_id(self):
        """Installation of the App on THIS repository's owner, resolved through
        the App JWT (never the config: one App is installed on several owners)."""
        if self.installation:
            return self.installation
        st = self.ctx.state()
        known = (st.get("gh_installation") or {}).get(self.ctx.owner)
        if known:
            self.installation = str(known)
            return self.installation
        page = 1
        while True:
            d = self._http("GET", "/app/installations?per_page=100&page=%d" % page, None, "Bearer " + self._jwt())
            if not isinstance(d, list):
                raise BackendError("github /app/installations returned no list")
            for i in d:
                if str((i.get("account") or {}).get("login") or "").lower() == str(self.ctx.owner).lower():
                    if i.get("suspended_at"):
                        raise BackendError("github app installation on %s is suspended" % self.ctx.owner)
                    self.installation = str(i["id"])
                    st = self.ctx.state()
                    st.setdefault("gh_installation", {})[self.ctx.owner] = self.installation
                    self.ctx.save(st)
                    return self.installation
            if len(d) < 100:
                raise BackendError("github app %s is not installed on %s" % (self.app_id, self.ctx.owner))
            page += 1

    def _token(self):
        cache = os.path.join(self.ctx.sdir, "gh_token.json")
        try:
            with open(cache, encoding="utf-8") as fh:
                c = json.load(fh)
            if c.get("token") and float(c.get("expires_at") or 0) - time.time() > self.TOKEN_MARGIN:
                return c["token"]
        except (OSError, ValueError):
            pass
        d = self._http("POST", "/app/installations/%s/access_tokens" % self._installation_id(),
                       None, "Bearer " + self._jwt())
        tok = d.get("token") or ""
        if not tok:
            raise BackendError("github app token response carried no token")
        exp = time.time() + 3000
        try:
            exp = float(calendar.timegm(time.strptime(d.get("expires_at") or "", "%Y-%m-%dT%H:%M:%SZ")))
        except ValueError:
            pass
        atomic_write_json(cache, {"token": tok, "expires_at": exp})
        return tok

    def _http(self, method, path, body, auth):
        data = json.dumps(body).encode() if body is not None else None
        hdrs = {"Accept": "application/vnd.github+json", "User-Agent": "tk",
                "X-GitHub-Api-Version": "2022-11-28"}
        if data is not None:
            hdrs["Content-Type"] = "application/json"
        if auth:
            hdrs["Authorization"] = auth
        req = urllib.request.Request(self.api + path, data=data, method=method, headers=hdrs)
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            detail = ""
            try:
                detail = (json.loads(e.read() or b"{}") or {}).get("message", "")
            except (ValueError, OSError):
                pass
            raise BackendError("github %s %s -> HTTP %d%s"
                               % (method, path, e.code, (": " + detail[:200]) if detail else ""))
        except (urllib.error.URLError, OSError) as e:
            raise BackendError("github unreachable: %s" % e)
        return json.loads(raw) if raw else {}

    def _drop_token(self):
        try:
            os.unlink(os.path.join(self.ctx.sdir, "gh_token.json"))
        except OSError:
            pass

    def gql(self, query, **v):
        body = {"query": query, "variables": v}
        try:
            d = self._http("POST", "/graphql", body, "bearer " + self._token())
        except BackendError as e:
            if "HTTP 401" not in str(e):
                raise
            # a cached installation token can be revoked before its stated expiry
            self._drop_token()
            d = self._http("POST", "/graphql", body, "bearer " + self._token())
        if d.get("errors"):
            raise BackendError("github graphql: " + str(d["errors"][0].get("message", ""))[:300])
        return d.get("data") or {}

    # -- project ------------------------------------------------------
    def ensure(self):
        st = self.ctx.state()
        self.pid = st.get("gh_project") or self.pid
        title = self.PROJECT % (self.ctx.repo or self.ctx.owner)
        if not self.pid:
            d = self.gql("query($l:String!){repositoryOwner(login:$l){id ... on User{projectsV2(first:50){nodes{id title public}}} ... on Organization{projectsV2(first:50){nodes{id title public}}}}}",
                         l=self.ctx.owner)
            owner = d.get("repositoryOwner") or {}
            found = next((n for n in (owner.get("projectsV2") or {}).get("nodes") or []
                          if n.get("title") == title), None)
            if found:
                self.pid = found["id"]
                public = found.get("public")
            else:
                c = self.gql("mutation($o:ID!,$t:String!){createProjectV2(input:{ownerId:$o,title:$t}){projectV2{id public}}}",
                             o=owner.get("id"), t=title)
                self.pid = c["createProjectV2"]["projectV2"]["id"]
                public = c["createProjectV2"]["projectV2"].get("public")
            if public is not False:
                # GitHub creates private projects; only change visibility when it is not (the App may lack that right)
                self.gql("mutation($p:ID!){updateProjectV2(input:{projectId:$p,public:false}){projectV2{id}}}",
                         p=self.pid)
            st = self.ctx.state()
            st["gh_project"] = self.pid
            self.ctx.save(st)
        st = self.ctx.state()
        if not (st.get("gh_field") and st.get("gh_options")):
            f = self.gql('query($p:ID!){node(id:$p){... on ProjectV2{fields(first:30){nodes{... on ProjectV2SingleSelectField{id name options{id name}}}}}}}',
                         p=self.pid)
            nodes = ((f.get("node") or {}).get("fields") or {}).get("nodes") or []
            sf = next((n for n in nodes if n and n.get("name") == "Status"), None)
            if not sf:
                raise BackendError("github project %s has no Status field" % self.pid)
            opts = {o["name"].lower(): o["id"] for o in sf.get("options") or []}
            pick = {
                "todo": opts.get("todo") or opts.get("backlog"),
                "in-progress": opts.get("in progress"),
                "review": opts.get("in review") or opts.get("review") or opts.get("in progress"),
                "done": opts.get("done"),
            }
            if not all(pick.values()):
                raise BackendError("github Status field lacks options for: %s"
                                   % ", ".join(k for k, v in pick.items() if not v))
            st.update({"gh_project": self.pid, "gh_field": sf["id"], "gh_options": pick})
            self.ctx.save(st)
        return "private project %s (%s)" % (title, self.pid)

    def _meta(self):
        st = self.ctx.state()
        if not (st.get("gh_field") and st.get("gh_options")):
            self.ensure()
            st = self.ctx.state()
        return st

    RECENT_TTL = 900

    def _items(self):
        """Listing plus the items this clone created recently: GitHub's items
        connection lags (measured >14 s) behind addProjectV2DraftIssue."""
        out = self._listed()
        st = self.ctx.state()
        recent = st.get("gh_recent") or {}
        seen = {n.get("id") for n in out}
        keep = {k: v for k, v in recent.items()
                if k not in seen and time.time() - float(v.get("at") or 0) < self.RECENT_TTL}
        if keep != recent:
            st["gh_recent"] = keep
            self.ctx.save(st)
        return out + [{kk: vv for kk, vv in v.items() if kk != "at"} for v in keep.values()]

    def _patch_recent(self, item, fn):
        st = self.ctx.state()
        node = (st.get("gh_recent") or {}).get(item)
        if node is not None:
            fn(node)
            self.ctx.save(st)

    def _listed(self):
        out, cur = [], ""
        while True:
            d = self.gql('query($p:ID!,$c:String){node(id:$p){... on ProjectV2{items(first:100,after:$c){pageInfo{hasNextPage endCursor} nodes{id content{... on DraftIssue{id title body}} fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name}}}}}}}',
                         p=self.pid, c=cur)
            it = (d.get("node") or {}).get("items") or {}
            out += [n for n in it.get("nodes") or [] if (n.get("content") or {}).get("title") is not None]
            if not (it.get("pageInfo") or {}).get("hasNextPage"):
                return out
            cur = it["pageInfo"]["endCursor"]

    @staticmethod
    def _status(n):
        name = ((n.get("fieldValueByName") or {}).get("name") or "todo").lower()
        return {"todo": "todo", "backlog": "todo", "in progress": "in-progress",
                "in review": "review", "review": "review", "done": "done"}.get(name, "todo")

    def _find(self, tid):
        for n in self._items():
            if ((n.get("content") or {}).get("title") or "").startswith("[%s]" % tid):
                return n
        die("unknown ticket " + tid)

    def new(self, title, body):
        tid = "tk-" + hashlib.sha1(("%s%s" % (title, time.time())).encode()).hexdigest()[:6]
        d = self.gql("mutation($p:ID!,$t:String!,$b:String!){addProjectV2DraftIssue(input:{projectId:$p,title:$t,body:$b}){projectItem{id content{... on DraftIssue{id}}}}}",
                     p=self.pid, t="[%s] %s" % (tid, title), b=body)
        item = d["addProjectV2DraftIssue"]["projectItem"]
        st = self.ctx.state()
        st.setdefault("gh_recent", {})[item["id"]] = {
            "id": item["id"], "at": time.time(), "fieldValueByName": {"name": "todo"},
            "content": {"id": (item.get("content") or {}).get("id"),
                        "title": "[%s] %s" % (tid, title), "body": body}}
        self.ctx.save(st)
        self._set(item["id"], "todo")
        return tid

    def _set(self, item, status):
        st = self._meta()
        self.gql("mutation($p:ID!,$i:ID!,$f:ID!,$o:String!){updateProjectV2ItemFieldValue(input:{projectId:$p,itemId:$i,fieldId:$f,value:{singleSelectOptionId:$o}}){projectV2Item{id}}}",
                 p=self.pid, i=item, f=st["gh_field"], o=st["gh_options"][status])
        self._patch_recent(item, lambda n: n.__setitem__("fieldValueByName", {"name": status.replace("-", " ")}))

    def _view(self, n):
        content = n.get("content") or {}
        title = content.get("title") or ""
        m = re.match(r"\[(tk-[0-9a-f]+)\]", title)
        body = content.get("body") or ""
        return {"id": m.group(1) if m else (content.get("id") or ""),
                "title": re.sub(r"^\[[^\]]+\]\s*", "", title),
                "status": self._status(n),
                "notes": body.count("\n---note---")}

    def get(self, tid):
        return self._view(self._find(tid))

    def set_status(self, tid, status):
        self._set(self._find(tid)["id"], status)

    def note(self, tid, text):
        n = self._find(tid)
        content = n.get("content") or {}
        self.gql("mutation($d:ID!,$b:String!){updateProjectV2DraftIssue(input:{draftIssueId:$d,body:$b}){draftIssue{id}}}",
                 d=content["id"], b=(content.get("body") or "") + "\n---note---\n" + text)
        self._patch_recent(n.get("id"), lambda x: x["content"].__setitem__(
            "body", (content.get("body") or "") + "\n---note---\n" + text))

    def list(self, show_done=False):
        return [self._view(n) for n in self._items() if show_done or self._status(n) != "done"]


KINDS = {"local": Local, "forgejo": Forgejo, "github": GitHub}


def backend_class(kind):
    cls = KINDS.get(kind)
    if cls is None:
        raise BackendError("unknown backend kind %r (expected: %s)" % (kind, ", ".join(sorted(KINDS))))
    return cls


def backend(ctx):
    return backend_class(ctx.state().get("backend") or ctx.kind)(ctx)


# ---------------------------------------------------------------- commands

def need_ctx():
    ctx = Ctx(os.getcwd())
    if not ctx.in_repo:
        die("not in a git repository")
    return ctx


def init(ctx, force=False):
    """Idempotent: pick the backend, prepare it; degrade to local with the real
    reason and retry the configured backend on a later init. A degraded backend
    is retried at most once per RETRY_SECONDS so a down API cannot stall every
    prompt; force (tk init --force) retries now."""
    st = ctx.state()
    if st.get("backend") and st.get("ready") and not st.get("degraded"):
        return "already initialised (%s)" % st["backend"]
    if st.get("degraded") and not force:
        wait = float(st.get("retry_at") or 0) - time.time()
        if wait > 0:
            return "local: %s [degraded to local: %s; retry in %ds]" % (
                st["backend"], st["degraded"], int(wait) + 1)
    kind = ctx.kind
    try:
        msg = backend_try(ctx, kind)
    except BackendError as e:
        reason = str(e)
        msg = backend_try(ctx, "local")
        degrade(ctx, reason)
        return "local: %s [degraded to local: %s]" % (msg, reason)
    st = ctx.state()
    st.update({"backend": kind, "ready": True})
    st.pop("degraded", None)
    st.pop("retry_at", None)
    ctx.save(st)
    return "%s: %s" % (kind, msg)


def degrade(ctx, reason):
    st = ctx.state()
    st.update({"backend": "local", "ready": False, "degraded": reason,
               "retry_at": time.time() + GitHub.RETRY_SECONDS})
    ctx.save(st)


def with_fallback(ctx, fn):
    """Run fn on the configured backend; if a remote backend fails at runtime
    (init only proves it once), degrade to local with the real reason and run
    fn once more, so a ticket can always become active."""
    try:
        return fn()
    except BackendError as e:
        if (ctx.state().get("backend") or ctx.kind) == "local":
            raise
        degrade(ctx, str(e))
        backend_try(ctx, "local")
        return fn()


def backend_try(ctx, kind):
    return backend_class(kind)(ctx).ensure()


def cmd_new(ctx, a):
    start = "--start" in a
    a = [x for x in a if x != "--start"]
    if not a:
        die('usage: tk new "<title: the owner request, verbatim>" [--start]')
    init(ctx)
    b = backend(ctx)
    tid = b.new(a[0], a[1] if len(a) > 1 else "")
    print(tid)
    if start:
        cmd_status(ctx, tid, "in-progress", b)


def cmd_status(ctx, tid, status, b=None):
    b = b or backend(ctx)
    b.set_status(tid, status)
    st = ctx.state()
    if status == "in-progress":
        st["active"] = tid
    elif st.get("active") == tid:
        st.pop("active", None)
    ctx.save(st)
    print("%s -> %s" % (tid, status))


def cmd_note(ctx, tid, text):
    backend(ctx).note(tid, text)
    st = ctx.state()
    st.setdefault("noted", [])
    if tid not in st["noted"]:
        st["noted"].append(tid)
    ctx.save(st)
    print("noted " + tid)


def cmd_detect(ctx):
    st = ctx.state()
    print(json.dumps({"root": ctx.top, "host": ctx.host, "owner": ctx.owner, "repo": ctx.repo, "kind": ctx.kind,
                      "enabled": ctx.enabled, "deferred": ctx.deferred, "initialised": bool(st.get("ready")),
                      "backend": st.get("backend"), "degraded": st.get("degraded"), "active": st.get("active")}))


CI_MOVES = {"start": "in-progress", "success": "review",
            "failure": "todo", "review": "review", "merged": "done"}


def parse_jobs(spec):
    """"a=success,b=failure" -> [(name, result)]; a bare name counts as skipped."""
    out = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        name, _, res = part.partition("=")
        out.append((name.strip(), res.strip() or "skipped"))
    return out


def jobs_note(jobs, ref):
    """Comment naming every job that did not succeed (failed, cancelled, skipped)."""
    bad = [(n, r) for n, r in jobs if r != "success"]
    run = ""
    srv, repo, rid = (os.environ.get(k) for k in ("GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_RUN_ID"))
    if srv and repo and rid:
        run = " Run: %s/%s/actions/runs/%s" % (srv.rstrip("/"), repo, rid)
    return "CI on %s is not green; moved to review. Not successful: %s.%s" % (
        ref, ", ".join("%s (%s)" % b for b in bad), run)


def forge_target(ctx):
    """(flavor, api, owner/repo, token) for PR calls: the CI environment first
    (GITHUB_API_URL and GITHUB_REPOSITORY are set by both Actions engines),
    then the host config."""
    api = (os.environ.get("TK_GH_API") or os.environ.get("GITHUB_API_URL") or "").rstrip("/")
    slug = os.environ.get("GITHUB_REPOSITORY") or ("%s/%s" % (ctx.owner, ctx.repo) if ctx.owner else "")
    tok = os.environ.get("TK_FORGE_TOKEN") or os.environ.get("GITHUB_TOKEN") or ""
    if api and tok:
        return ("forgejo" if api.endswith("/api/v1") else "github"), api, slug, tok
    if ctx.kind == "forgejo":
        b = Forgejo(ctx)
        return "forgejo", b.api, slug, b.tok
    if ctx.kind == "github":
        b = GitHub(ctx)
        return "github", b.api, slug, b._token()
    raise BackendError("no forge to merge on: set TK_FORGE_TOKEN (and GITHUB_API_URL) or configure the host")


def forge_call(flavor, api, tok, method, path, body=None):
    hdrs = {"Authorization": "token " + tok, "Content-Type": "application/json",
            "Accept": "application/json", "User-Agent": "tk"}
    req = urllib.request.Request(api + path, data=json.dumps(body).encode() if body is not None else None,
                                 method=method, headers=hdrs)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = (json.loads(e.read() or b"{}") or {}).get("message", "")
        except (ValueError, OSError):
            pass
        raise BackendError("%s %s %s -> HTTP %d%s" % (flavor, method, path, e.code,
                                                      (": " + detail[:200]) if detail else ""))
    except (urllib.error.URLError, OSError) as e:
        raise BackendError("%s unreachable: %s" % (flavor, e))
    return json.loads(raw) if raw else {}


def pr_merge(ctx, branch, sha=""):
    """Open a PR from branch into the default branch and merge it. Idempotent:
    reuses an open PR; a default or vanished branch is a no-op. Never echoes
    the token. Returns (merged, one-line verdict)."""
    flavor, api, slug, tok = forge_target(ctx)
    base = "/repos/" + slug
    default = (forge_call(flavor, api, tok, "GET", base) or {}).get("default_branch")
    if not default:
        raise BackendError("default branch of %s unknown" % slug)
    if branch == default:
        return False, "%s is the default branch: nothing to merge" % branch
    if sha:
        try:
            tip = forge_call(flavor, api, tok, "GET", "%s/branches/%s" % (base, urllib.parse.quote(branch, safe="")))
        except BackendError as e:
            if "HTTP 404" in str(e):
                return False, "branch %s is gone: nothing to merge" % branch
            raise
        c = tip.get("commit") or {}
        tipsha = c.get("id") or c.get("sha") or ""
        if tipsha and tipsha != sha:
            return False, "branch %s moved past %s: a newer run owns the merge" % (branch, sha[:8])
    pulls = forge_call(flavor, api, tok, "GET", base + "/pulls?state=open&limit=50") or []
    pr = next((p for p in pulls if (p.get("head") or {}).get("ref") == branch
               and (p.get("base") or {}).get("ref") == default), None)
    if pr is None:
        pr = forge_call(flavor, api, tok, "POST", base + "/pulls",
                        {"title": branch, "head": branch, "base": default})
    num = pr.get("number")
    if flavor == "github":
        forge_call(flavor, api, tok, "PUT", "%s/pulls/%s/merge" % (base, num),
                   dict({"merge_method": "merge"}, **({"sha": sha} if sha else {})))
    else:
        forge_call(flavor, api, tok, "POST", "%s/pulls/%s/merge" % (base, num),
                   dict({"Do": "merge"}, **({"head_commit_id": sha} if sha else {})))
    return True, "merged PR #%s (%s -> %s)" % (num, branch, default)


def cmd_ci(ctx, ref, result, jobs=None, sha=""):
    """CI step: move the ticket or warn, never fail the build.

    ref = branch name or ticket id; result = start|success|failure|review|
    merge|merged: start -> in-progress, success -> review, failure -> todo,
    review (with --jobs "a=success,b=failure") -> review plus a note naming
    each job that did not succeed, nothing when all succeeded; merge opens a
    PR into the default branch, merges it and only then moves to done
    (merged -> done directly, kept for older pipelines).
    """
    m = re.search(r"(tk-[0-9a-f]+|L\d+|\d+)", ref.rsplit("/", 1)[-1])
    if result == "merge":
        # the one non-bookkeeping action: failures propagate and fail the job
        merged, verdict = pr_merge(ctx, ref, sha)
        print(verdict)
        if not merged:
            return  # the ticket reaches done only through a real merge
        result = "merged"
    if not m:
        print("::warning::no ticket id in %r: work is not tracked" % ref)
        return
    tid = m.group(1)
    if result == "review" and jobs is not None and all(r == "success" for _, r in jobs):
        print("%s: every job succeeded: nothing to move (auto-merge owns it)" % tid)
        return
    status = CI_MOVES.get(result)
    if not status:
        print("%s: unknown result %r (no move)" % (tid, result))
        return
    st = ctx.state()
    if st.get("degraded"):
        print("::warning::%s: ticket %s not moved" % (st["degraded"], tid))
        return
    if ctx.remote and ctx.kind == "local" and not ctx.hostcfg:
        print("::warning::no backend for host %r in %s: ticket %s not moved"
              % (ctx.host, cfg_path(), tid))
        return
    try:
        b = backend(ctx)
        b.set_status(tid, status)
        if result == "review" and jobs is not None:
            b.note(tid, jobs_note(jobs, ref))
    except SystemExit:  # die() from a backend on an unknown ticket
        print("::warning::ticket %s not found: not moved" % tid)
        return
    except BackendError as e:
        print("::warning::%s: ticket %s not moved" % (e, tid))
        return
    except Exception as e:  # bookkeeping must never break a build
        print("::warning::tk ci error for %s: %r" % (tid, e))
        return
    print("%s -> %s" % (tid, status))


# ---------------------------------------------------------------- alignment

ALIGN_JOBS = ("rules", "gate", "start", "board", "auto-merge")
CI_KINDS = {"forgejo": (".forgejo/workflows", "forgejo-ci.yml"), "github": (".github/workflows", "github-ci.yml")}
CI_FILE = "tk.yml"
GATE_TARGETS = ("gate", "check", "test")


def tk_home():
    """The tk data dir (templates, notices, session state) next to this script."""
    return os.environ.get("TK_HOME") or os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tk")


def read_text(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def ci_workflows(ctx):
    """(dir, [(file, text)]) of the workflow files for this repo's forge kind, or None."""
    spec = CI_KINDS.get(ctx.kind)
    if not spec:
        return None
    d = os.path.join(ctx.top, spec[0])
    out = []
    if os.path.isdir(d):
        for n in sorted(os.listdir(d)):
            if n.endswith((".yml", ".yaml")):
                out.append((n, read_text(os.path.join(d, n))))
    return d, out


def ci_missing_jobs(text):
    """Jobs of the tk pipeline absent from a workflow that carries the tk ci marker."""
    if "tk ci" not in text:
        return list(ALIGN_JOBS)
    return [j for j in ALIGN_JOBS if not re.search(r"^  %s:\s*$" % re.escape(j), text, re.M)]


def has_gate_target(ctx):
    """Same probe as the CI gate step: make -n on gate, check, test."""
    for t in GATE_TARGETS:
        code, _, _ = run(["make", "-n", t], cwd=ctx.top)
        if code == 0:
            return True
    return False


def align_report(ctx):
    """{aligned, missing:[{id, why, fix}]}: everything a repo needs so tickets,
    rules and CI work. Dynamic: kind from the remote, targets probed with make."""
    miss = []
    if not os.path.exists(os.path.join(ctx.top, "RULES.md")):
        miss.append({"id": "rules", "why": "no RULES.md at the repo root",
                     "fix": "copy ~/.claude/skills/code-law/rules.md to RULES.md, then adapt it (skill code-law)"})
    wf = ci_workflows(ctx)
    if wf is not None:
        d, files = wf
        best = min((ci_missing_jobs(t) for _, t in files), key=len, default=list(ALIGN_JOBS))
        if best:
            rel = os.path.relpath(d, ctx.top)
            miss.append({"id": "ci", "why": "no workflow under %s with the tk jobs (%s missing)" % (rel, ", ".join(best)),
                         "fix": "tk align --fix ci"})
        if not has_gate_target(ctx):
            miss.append({"id": "gate", "why": "no Makefile target gate|check|test: the CI gate job would fail",
                         "fix": "add a Makefile target gate (or check, or test) that runs lint and tests"})
    if not ctx.deferred:
        st = ctx.state()
        if not st.get("ready") or st.get("degraded"):
            why = "tk backend degraded: %s" % st["degraded"] if st.get("degraded") else "tk backend not initialised"
            miss.append({"id": "tk", "why": why, "fix": "tk init --force"})
    return {"aligned": not miss, "missing": miss}


def align_fix_ci(ctx):
    """Install the CI template for the detected forge kind. Never overwrites a
    different file, never writes secrets (templates carry none). Idempotent."""
    spec = CI_KINDS.get(ctx.kind)
    if not spec:
        return {"fixed": [], "conflicts": [], "note": "no forge detected from the remote: no CI to install"}
    tpl = read_text(os.path.join(tk_home(), "templates", spec[1]))
    if not tpl:
        return {"fixed": [], "conflicts": ["template %s not readable" % spec[1]]}
    d = os.path.join(ctx.top, spec[0])
    target = os.path.join(d, CI_FILE)
    rel = os.path.relpath(target, ctx.top)
    cur = read_text(target)
    if os.path.exists(target):
        if cur == tpl:
            return {"fixed": [], "conflicts": []}
        return {"fixed": [], "conflicts": ["%s exists and differs from the template: merge the tk jobs by hand" % rel]}
    os.makedirs(d, exist_ok=True)
    with open(target, "w", encoding="utf-8") as fh:
        fh.write(tpl)
    return {"fixed": [rel], "conflicts": []}


def align_line(ctx):
    """One short reminder line for a misaligned in-scope repo, else ''."""
    rep = align_report(ctx)
    if rep["aligned"]:
        return ""
    ids = ", ".join(m["id"] for m in rep["missing"])
    fixes = "; ".join("%s: %s" % (m["id"], m["fix"]) for m in rep["missing"])
    return "[tk-align] repo not aligned: %s. Before other work: %s (owner order)" % (ids, fixes)


def cmd_align(ctx, a):
    out = {}
    if "--fix" in a:
        what = a[a.index("--fix") + 1] if a.index("--fix") + 1 < len(a) else ""
        if what != "ci":
            die("usage: tk align [--fix ci]")
        out = align_fix_ci(ctx)
    rep = align_report(ctx)
    rep["scope"] = ctx.enabled
    rep.update(out)
    print(json.dumps(rep))


def safe_sid(sid):
    sid = str(sid or "")
    if re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", sid) and sid not in (".", ".."):
        return sid
    return hashlib.sha256(sid.encode()).hexdigest()[:32] if sid else ""


SESSION_TTL = 30 * 86400


def broadcast(sid):
    """Notices in <tk>/notices/*.txt not yet shown to this session id: returns
    their one-line texts and records them (atomic, locked, per session)."""
    sid = safe_sid(sid)
    nd = os.path.join(tk_home(), "notices")
    if not sid or not os.path.isdir(nd):
        return []
    notices = [(n[:-4], " ".join(read_text(os.path.join(nd, n)).split()))
               for n in sorted(os.listdir(nd)) if n.endswith(".txt")]
    notices = [(i, t) for i, t in notices if t]
    sd = os.path.join(tk_home(), "sessions")
    path = os.path.join(sd, sid + ".json")
    with file_lock(os.path.join(sd, ".lock")):
        try:
            with open(path, encoding="utf-8") as fh:
                seen = json.load(fh).get("seen", [])
        except (OSError, ValueError):
            seen = []
        new = [(i, t) for i, t in notices if i not in seen]
        if new:
            atomic_write_json(path, {"seen": seen + [i for i, _ in new]})
            now = time.time()
            for n in os.listdir(sd):
                p = os.path.join(sd, n)
                if n.endswith(".json") and now - os.path.getmtime(p) > SESSION_TTL:
                    try:
                        os.unlink(p)
                    except OSError:
                        pass
    return ["[tk-notice %s] %s" % (i, t) for i, t in new]


def main(argv):
    if not argv:
        die("usage: tk detect|init|align|new|start|review|done|note|show|list|active|ci|hook")
    c, a = argv[0], argv[1:]
    if c == "hook":
        try:
            import tkhook
        except Exception as e:  # fail-open: a hook that cannot load must never block
            sys.stderr.write("tk hook unavailable (ignored): %r\n" % e)
            return 0
        return tkhook.main(a[0] if a else "")
    ctx = need_ctx()
    if c == "detect":
        return cmd_detect(ctx)
    if c == "init":
        print(init(ctx, "--force" in a))
    elif c == "align":
        cmd_align(ctx, a)
    elif c == "new":
        with_fallback(ctx, lambda: cmd_new(ctx, a))
    elif c in ("start", "review", "done"):
        if not a:
            die("usage: tk %s <id>" % c)
        init(ctx)
        with_fallback(ctx, lambda: cmd_status(ctx, a[0], {"start": "in-progress"}.get(c, c)))
    elif c == "note":
        if len(a) < 2:
            die('usage: tk note <id> "<plan or report>"')
        cmd_note(ctx, a[0], " ".join(a[1:]))
    elif c == "show":
        print(json.dumps(backend(ctx).get(a[0])))
    elif c == "list":
        for t in backend(ctx).list("--all" in a):
            print("%s\t%s\t%s" % (t["id"], t["status"], t["title"]))
    elif c == "active":
        print(ctx.state().get("active", ""))
    elif c == "ci":
        pos, jobs, sha, i = [], None, "", 0
        while i < len(a):
            if a[i] == "--jobs" and i + 1 < len(a):
                jobs, i = parse_jobs(a[i + 1]), i + 2
            elif a[i] == "--sha" and i + 1 < len(a):
                sha, i = a[i + 1], i + 2
            else:
                pos.append(a[i])
                i += 1
        if not pos:
            die('usage: tk ci <branch|id> start|success|failure|review|merge|merged [--jobs "a=success,b=failure"] [--sha S]')
        cmd_ci(ctx, pos[0], pos[1] if len(pos) > 1 else "", jobs, sha)
    else:
        die("unknown command " + c)


if __name__ == "__main__":
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        main(sys.argv[1:])
    except BackendError as e:
        die(str(e))
