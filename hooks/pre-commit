#!/bin/sh
# Pre-commit gate: docs move with the code, tests are not deleted to go green,
# the workflows lint, the host unit tests pass with per-file coverage.
# No escape hatch: a genuine no-op is written as such in the wiki changelog.
set -e

hook_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=hooks/lib.sh
. "$hook_dir/lib.sh"

root=$(repo_root)
cd "$root"

staged() {
	git diff --cached --name-only --diff-filter=ACMR
}

code_staged=$(staged | grep -E '^(sysmodule/source|overlay/source|scripts)/' || true)
tests_staged=$(staged | grep -E '^(tests/.*\.(cpp|hpp|h)|tests/Makefile|sysmodule/source/.*|scripts/check-coverage\.py)$' || true)
flow_staged=$(staged | grep -E '^(Makefile|hooks/|\.github/workflows/|scripts/ci/|docker-compose[^/]*\.yml|\.claude/hooks/)' || true)
workflows_staged=$(staged | grep -E '^\.github/workflows/.*\.ya?ml$' || true)

# 1. Documentation moves WITH the code ------------------------------------
if [ -n "$code_staged" ] || [ -n "$flow_staged" ]; then
	wd=$(wiki_dir)
	if [ -z "$wd" ]; then
		echo "✗ the wiki is not reachable: ./docs must be a symlink to the wiki clone." >&2
		echo "  Clone <repo>.wiki next to this repo and run: ln -s ../<repo>.wiki docs" >&2
		exit 1
	fi

	# The generated reference and navigation must equal what the sources say:
	# regenerate, then any drift shows up as an uncommitted wiki change below.
	if [ -n "$code_staged" ]; then
		python3 scripts/gen_docs.py >/dev/null
	fi

	if [ -n "$(wiki_git status --porcelain)" ]; then
		echo "✗ the wiki has uncommitted changes (hand-written or regenerated by make docs): commit them inside docs/ first." >&2
		exit 1
	fi

	# Reference point: the previous commit of this branch. A wiki commit made
	# after it, touching the page, is the proof that the page moved with this change.
	if previous=$(git log -1 --format=%ct HEAD 2>/dev/null); then
		moved_since() {
			ts=$(wiki_git log -1 --format=%ct -- "$1" 2>/dev/null || true)
			[ -n "$ts" ] && [ "$ts" -gt "$previous" ]
		}

		if [ -n "$code_staged" ]; then
			for page in Handoff-Changes.md Technique-Changelog.md User-Changelog.md Handoff-Current-State.md; do
				if ! moved_since "$page"; then
					echo "✗ code changed but the wiki page $page was not committed since the previous commit." >&2
					echo "  Edit it inside docs/, commit it there, then retry. Editing the page forces a re-read of the docs against the code." >&2
					exit 1
				fi
			done
		fi

		if [ -n "$flow_staged" ]; then
			if ! moved_since Handoff-Dev-Flow.md && ! staged | grep -qx '.claude/skills/dev-flow/SKILL.md'; then
				echo "✗ the dev flow changed (Makefile, hooks, workflows, compose, ci scripts)." >&2
				echo "  Move wiki page Handoff-Dev-Flow.md or stage .claude/skills/dev-flow/SKILL.md." >&2
				exit 1
			fi
		fi
	fi
fi

# 1b. A test file deleted while no source goes away is refused -------------
# Reads DELETIONS only: it cannot see a test emptied of its assertions or
# weakened. Renames (git -M) are legitimate and pass.
renamed_away=$(git diff --cached -M --name-status --diff-filter=R | cut -f2)
deleted_tests=$(git diff --cached --no-renames --name-status --diff-filter=D \
	| cut -f2 | grep -E '^tests/[^/]+_tests\.cpp$' || true)
sources_deleted=$(git diff --cached --no-renames --name-status --diff-filter=D \
	| cut -f2 | grep -E '^(sysmodule|overlay)/source/' || true)

for gone in $deleted_tests; do
	if printf '%s\n' "$renamed_away" | grep -qxF -- "$gone"; then
		continue
	fi
	if [ -z "$sources_deleted" ]; then
		echo "✗ $gone is deleted but no source file is deleted in this commit." >&2
		echo "  Delete the source in the same commit or rename the test; never drop the proof alone." >&2
		exit 1
	fi
done

# 2. Workflows lint --------------------------------------------------------
if [ -n "$workflows_staged" ]; then
	echo "pre-commit: workflow lint"
	make workflow-lint
fi

# 3. Host unit tests + per-file coverage, in the build container ------------
if [ -n "$tests_staged" ]; then
	MIN_COVERAGE="${MIN_COVERAGE:-80}"
	echo "pre-commit: unit tests with coverage"
	COVERAGE=1 docker compose run --rm test
	echo "pre-commit: per-file coverage >= ${MIN_COVERAGE}%"
	docker compose run --rm --entrypoint python3 test /workspace/scripts/check-coverage.py --min "$MIN_COVERAGE" --root /workspace
fi
